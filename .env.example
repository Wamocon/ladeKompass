# =============================================================================
# Environment Variables — Template
# =============================================================================
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local   (Linux/Mac)
#   copy .env.example .env.local  (Windows)
#
# NEVER commit .env.local to version control!
# =============================================================================

# --- Next.js -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=LadeKompass

# --- Supabase ----------------------------------------------------------------
# Hol dir diese Werte unter: https://supabase.com/dashboard → Projekt → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# The Supabase schema used by the application.
# Use "public" (default) or a custom schema name (e.g. "ladekompass-dev").
# Must match the schema exposed in Supabase → Project Settings → API → Exposed schemas.
SUPABASE_DB_SCHEMA=public
# Für Client-Components (wird im Browser sichtbar):
NEXT_PUBLIC_SUPABASE_SCHEMA=public

# --- Open Charge Map (Ladesäulen-Karte) ------------------------------------
# KOSTENLOS: https://openchargemap.org/site/develop/api
# Registrierung → "Register" → API Key anfordern
# Ohne Key: max. ~10 Anfragen/Minute (stark limitiert)
# Mit Key: 1.000+ Anfragen/Minute kostenlos
OCM_API_KEY=your-ocm-api-key-here

# --- Optional: Chargeprice API (Tarifvergleich) ----------------------------
# https://www.chargeprice.app/api-access
# Kostenlose Testlizenz verfügbar für Non-Profit / Open Source Projekte
# CHARGEPRICE_API_KEY=

# --- Optional: Google Maps (Geocoding / Routenberechnung) ------------------
# Benötigt ein GCP-Projekt mit aktivierter Geocoding API
# https://console.cloud.google.com/apis/library/geocoding-backend.googleapis.com
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Optional: E-Mail (Transaktions-Mails, Passwort-Reset) -----------------
# https://resend.com → kostenloses Tier: 100 E-Mails/Tag
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@ladekompass.de
